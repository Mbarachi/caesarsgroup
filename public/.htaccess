# Caesars Energy Services — Apache configuration
#
# Drop this in the web root alongside index.html. It does four jobs:
#   1. forces one canonical origin, so ranking signals stop splitting
#   2. serves the prerendered page for each route
#   3. returns a real 404 for anything else, instead of 200 + the homepage
#   4. compresses and caches static assets
#
# Before this, every URL on the site returned 200 OK — including nonsense ones —
# which Google treats as a "soft 404" and counts against crawl budget.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 1. Canonical origin: https, no www ─────────────────────────────────────
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://caesarsgroup.ng%{REQUEST_URI} [R=301,L]

  # ── 2. Prerendered routes ──────────────────────────────────────────────────
  # Serve /about from /about/index.html *without* bouncing to /about/, so the
  # URL the sitemap advertises is the URL that answers.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # Strip a trailing slash on anything else, to keep one URL per page.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# ── 3. A real 404 ────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── 4. Compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ── 5. Caching ───────────────────────────────────────────────────────────────
# Two different rules, and the distinction matters.
#
# Files under /static carry a content hash in the name (main.3ee211df.js), so a
# changed file is a different URL and can be cached forever.
#
# Files at the web root keep their names between builds — favicon.ico,
# logo192.png, logo512.png, hero_image.png. Caching those as "immutable" pins a
# stale icon in every browser and proxy that ever fetched one, which is exactly
# how a replaced favicon appears not to have changed.
#
# Apache applies the LAST matching Header directive, so the long-lived rule is
# written after the short-lived one deliberately.
<IfModule mod_headers.c>
  # Default for static assets: a day, and revalidate after that.
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Fingerprinted build output only — safe to pin for a year.
  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be revalidated, or visitors keep seeing an old build.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType application/xml .xml
AddDefaultCharset UTF-8
